# backend/.env.example
# ─────────────────────────────────────────────────────────────────────────────
# Commit this file. Copy to .env and fill in your actual values.
# Never commit .env — it is git-ignored.
# ─────────────────────────────────────────────────────────────────────────────

# true = verbose debug logs
DEBUG=false

# Path to the Vite production build output (frontend/dist).
# Relative paths are resolved from the working directory where Uvicorn runs.
FRONTEND_BUILD_DIR=../frontend/dist

# CORS origins — only needed when Vite dev server runs on a separate port.
# In single-host production mode this value is effectively unused.
ALLOWED_ORIGINS=http://localhost:5173
